# Copy to .env and fill in. .env is gitignored — keep it that way.
# A key that lands in git history is compromised even in a private repo:
# rotate it, don't try to `git rm` it.

# mock = runs offline, no key, deterministic. anthropic = real calls.
LLM_BACKEND=mock

ANTHROPIC_API_KEY=

# Cascade tiers. Cheap handles the easy mass, strong gets the escalations.
MODEL_CHEAP=claude-haiku-5-5
MODEL_STRONG=claude-opus-5-5

# low | medium | high | xhigh | max
EFFORT_CHEAP=low
EFFORT_STRONG=medium

# Abstain instead of answering below this verifier confidence.
CONFIDENCE_FLOOR=0.6
